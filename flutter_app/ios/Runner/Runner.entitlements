<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode / the App Store profile switches this to "production" automatically when you archive. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Incoming-call alerts break through Focus / Do Not Disturb settings the person allows (fallback when no VoIP token) -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
