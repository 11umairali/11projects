<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="top" android:layoutDirection="ltr"
    android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="top">
    <FrameLayout android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="10dp">
        <ImageView android:id="@+id/notification_brand"
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@mipmap/ic_dahimail_launcher" android:scaleType="fitCenter" android:contentDescription="Dahimail" />
        <ImageView android:id="@+id/notification_type_icon"
            android:layout_width="16dp" android:layout_height="16dp"
            android:layout_gravity="bottom|right" android:padding="3dp"
            android:background="@drawable/notification_category_badge"
            android:tint="@android:color/white" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/notification_sender"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="14sp" android:textStyle="normal" android:includeFontPadding="false"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/notification_body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:layout_marginTop="3dp" android:textSize="13sp" android:includeFontPadding="false"
            android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="48dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="right" android:layout_marginStart="8dp">
        <TextView android:id="@+id/notification_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
            android:textSize="10sp" android:maxLines="1" android:includeFontPadding="false" />
        <ImageView android:id="@+id/notification_avatar"
            android:layout_width="32dp" android:layout_height="32dp" android:layout_marginTop="3dp"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
