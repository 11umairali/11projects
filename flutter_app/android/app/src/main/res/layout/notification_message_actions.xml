<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_actions"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <Button android:id="@+id/notification_view"
        android:layout_width="wrap_content" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
        android:layout_marginEnd="16dp" android:background="@android:color/transparent"
        android:text="@string/notification_view" android:textAllCaps="false"
        android:textColor="#2563EB" android:textStyle="bold" android:textSize="10sp"
        android:includeFontPadding="false" android:gravity="center_vertical" />
    <Button android:id="@+id/notification_reply"
        android:layout_width="wrap_content" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
        android:background="@android:color/transparent"
        android:text="@string/notification_reply" android:textAllCaps="false"
        android:textColor="#2563EB" android:textStyle="bold" android:textSize="10sp"
        android:includeFontPadding="false" android:gravity="center_vertical" />
</LinearLayout>
