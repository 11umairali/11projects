<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/friend_widget_background">
    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp">
        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/widget_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/friend_widget_avatar"
            android:text="+"
            android:textColor="#687386"
            android:textSize="34sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeStepGranularity="1sp"
        android:text="@string/friend_widget_choose"
        android:textColor="#18212F"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/friend_widget_setup"
        android:textColor="#687386"
        android:textSize="11sp" />
</LinearLayout>
