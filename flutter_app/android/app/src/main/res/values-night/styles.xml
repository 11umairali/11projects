<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ONE splash for every Android version (androidx core-splashscreen): white background + logo/name, kept on screen
         until the app has drawn its first real screen. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/dahimail_splash</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <!-- Behind the Flutter UI once it is running. AppCompat parent is required by the fingerprint / face prompt. -->
    <style name="NormalTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>
